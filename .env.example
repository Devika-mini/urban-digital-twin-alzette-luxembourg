# Alzette digital twin: settings and secrets.
#
# Copy this file to ".env" in the same folder (the repository root) and fill in the empty values:
#     cp .env.example .env
# .env is git-ignored: never commit it. ./start.sh refuses to start while a required value is empty.
# Lines are KEY=value, without quotes or spaces around "=".

# ---------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------

# PostGIS database. The password is yours to choose; the database is created with it on the first start.
# (Changing it later needs the database volume reset: ./start.sh reset --volumes.)
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Port of the database on this computer (inside Docker it is always 5432).
POSTGRES_PORT=5431

# GeoServer (map layers). The admin password is yours to choose, like the database's.
GEOSERVER_HOST=http://localhost
GEOSERVER_PORT=8088
GEOSERVER_ADMIN_NAME=admin
GEOSERVER_ADMIN_PASSWORD=

# Backend API, as the browser reaches it. Keep the port 5000: docker-compose.yml publishes that port.
BACKEND_HOST=http://localhost
BACKEND_PORT=5000

# Port of the map (TerriaJS) on this computer.
WWW_PORT=3001

# Keys of New Zealand data services (StatsNZ, LINZ, MfE). The EDDIE library this twin is built on refuses
# to start without them, but the Luxembourg twin never calls these services: any non-empty text works,
# e.g. "unused". Real keys come from datafinder.stats.govt.nz, data.linz.govt.nz and data.mfe.govt.nz.
STATSNZ_API_KEY=
LINZ_API_KEY=
MFE_API_KEY=

# ---------------------------------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------------------------------

# Cesium ion access token (free account at https://ion.cesium.com/tokens), used by the 3D map for
# Cesium's own imagery and services. The twin's own terrain and orthophoto work without it;
# ./start.sh warns when it is empty.
CESIUM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------------------
# Optional: running the stack
# ---------------------------------------------------------------------------------------------------

# Name of the Docker Compose project (prefix of the images and volumes). Default eddie_antarctica.
# COMPOSE_PROJECT_NAME=eddie_antarctica
# Seconds ./start.sh waits for the services to become healthy. Default 900.
# TWIN_HEALTH_TIMEOUT=900

# Only for running Python on this computer against the stack (inside Docker these are set by
# EDDIE/eddie_antarctica/.env.docker-override).
# POSTGRES_HOST=localhost
# MESSAGE_BROKER_HOST=localhost
# DATA_DIR=./stored_data
# DATA_DIR_GEOSERVER=./stored_data/geoserver

# CRS the EDDIE core works in, e.g. EPSG:2169. Default: derived from the area of interest.
# EDDIE_WORKING_CRS=

# ---------------------------------------------------------------------------------------------------
# Optional: the twin's models (defaults in EDDIE/eddie_antarctica/docker-compose.override.yml).
# They change precomputed data, so restart the stack after changing them (./start.sh).
# ---------------------------------------------------------------------------------------------------

# Must equal the --height-offset given to scripts/prepare_dem.py (0 with start.sh).
# TERRAIN_HEIGHT_OFFSET=0
# Metres the water drawn from gauge levels is raised.
# WATER_RENDER_OFFSET=0
# Minimum metres of water above the terrain inside the river channel (grid method only).
# CHANNEL_MARGIN=0.05
# Gauge-stage step (cm) of the precomputed water levels.
# WATER_LEVEL_STEP_CM=10
# Cell size (m) of the drawn water mesh.
# WATER_MESH_M=2
# Velocity estimate: Manning roughness and slope smoothing distance (m).
# MANNING_N=0.035
# SLOPE_SMOOTHING_M=300
# Default slope shading: starts at / full colour from (degrees). The map's Terrain panel overrides them.
# SLOPE_SHADING_START_DEG=25
# SLOPE_SHADING_FULL_DEG=60
# Water surface of the flood scenarios: "sections" or "grid"; half-width (m) of the band the sections cover.
# WATER_SURFACE_METHOD=sections
# SECTION_CORRIDOR_M=700
# Water of gauge levels: "rem" or "sections"; smallest rise (m) above the REM base surface.
# LIVE_WATER_METHOD=rem
# REM_MIN_RISE_M=0.15
# Height (m) of 3D buildings without height data.
# BUILDING_HEIGHT_M=10
# Minutes between the gauge collector's runs (0 = off).
# COLLECT_INTERVAL_MIN=15

# Optional immutable flood-cost release pair (container paths); empty uses the database.
# Keep the lookup and its SHA-matched monetary GeoJSON in one versioned external folder.
# FLOOD_COSTS_LOOKUP_PATH=/app/data/flood_costs/releases/RELEASE_ID/eddie_flood_costs_lookup_v2.json
# FLOOD_COSTS_DETAILS_PATH=/app/data/flood_costs/releases/RELEASE_ID/building_flood_damage.geojson
# For explicit calculation jobs only: verified original HQ10/HQ100 evidence and active approvals.
# FLOOD_COSTS_BASELINE_ROOT=/app/data/flood_costs/backups/hq10_hq100_BASELINE_ID
# FLOOD_COSTS_STAGE_OSM=/app/data/flood_costs/outputs/osm_classification
